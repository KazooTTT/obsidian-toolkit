{
  "name": "obsidian-toolkit",
  "version": "0.1.0",
  "description": "Personal Obsidian toolkit plugin.",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "release": "bumpp package.json manifest.json --commit \"chore(release): v%s\" --tag \"%s\" --push",
    "release:patch": "bumpp package.json manifest.json --release patch --commit \"chore(release): v%s\" --tag \"%s\" --push",
    "release:minor": "bumpp package.json manifest.json --release minor --commit \"chore(release): v%s\" --tag \"%s\" --push",
    "release:major": "bumpp package.json manifest.json --release major --commit \"chore(release): v%s\" --tag \"%s\" --push"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "outline",
    "tree"
  ],
  "author": "KazooTTT",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.10",
    "builtin-modules": "^3.3.0",
    "bumpp": "^11.1.0",
    "esbuild": "^0.21.5",
    "obsidian": "^1.6.7",
    "tslib": "^2.6.3",
    "typescript": "^5.5.3",
    "vitest": "^4.1.10"
  }
}
